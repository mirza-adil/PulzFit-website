# Copy to .env.local (dev) or set in your hosting provider's environment.

# Contact form endpoint. Any service that accepts a JSON POST works,
# e.g. Formspree: https://formspree.io/f/<your-form-id>
# If unset, the form opens the visitor's email client instead.
VITE_CONTACT_ENDPOINT=

# Checkout / store URL (Shopify, Stripe Payment Link, etc.).
# "?plan=<id>" is appended for subscription CTAs.
# If unset, "Buy Now" scrolls to the pricing section.
VITE_CHECKOUT_URL=

# Public site origin used at build time for canonical URL, Open Graph, sitemap.
SITE_URL=https://pulzfit.com

# Firebase Analytics (GA4). Copy from Firebase console → Project settings →
# General → Your apps → Web app config. Analytics stays off until
# API key, App ID and Measurement ID are all set.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
